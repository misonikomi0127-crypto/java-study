package practice;
import java.util.ArrayList;
import java.util.Scanner;

public class Todo{
	static ArrayList<String> tasks = new ArrayList<>();
	
	public static void addTask(String task) {
		tasks.add(task);
		System.out.println("追加しました: " + task);
	}
	
	public static void viewTasks() {
		System.out.println("一覧です");
		if(tasks.isEmpty()) {
			System.out.println("リストがありません");
		}else {
			for(int i = 0; i < tasks.size(); i++){
				//ArrayListから値を取り出すにはget()が必要
				System.out.println((i + 1) + ":" + tasks.get(i));
			}
		}
	}
	
	public static void deleteTask(int index) {
		if(index >= 0 && index < tasks.size()) {
			String removed = tasks.remove(index);
			System.out.println("削除しました: " + removed);
	 //値が違う場合も入力
		}else {
			System.out.println("値がまちがっている");
		}
		
		public static void completedTask(int index) {
			if(index >= 0 && index < tasks.size()) {
				tasks.set(index,get(index) + "完了");
			}else {
				System.out.println("値がまちがっています");
			}
		}
	}
	
	public static void main(String[] args) {
		Scanner scanner = new Scanner(System.in);
		while(true) {
			System.out.println("\n1.追加 2.表示 3.削除 4.終了 5.完了");
			String input = scanner.nextLine();
			switch(input) {
			//終了時にはbreakをつける
			case"1":
				System.out.println("追加するタスクを入力してください");
				String task = scanner.nextLine();
				addTask(task);
				break;
				
			case"2":
				viewTasks();
				break;
				
			case"3":
				System.out.println("削除するタスクを入力してください");
				int index = Integer.parseInt(scanner.nextLine()) -1;
				deleteTask(index);
				break;
				
			case"4":
				System.out.println("しゅうりょうします");
				scanner.close();
				break;
				
			case"5":
				System.out.println("完了するタスクを入力してくしてください");
				int index = Integer.parseInt(scanner.nextLine()) -1;
				completedTask(index);
				breask;
				
				default:
					System.out.println("値が間違っています");
			
			}
		}
	}
	
}
